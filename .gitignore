# Screenshots from scripts/shoot.mjs - a look at the running game, not an artefact.
# scripts/.shots/ at the repo root is the ONE place they belong. The bare
# .shots/ below is a catch-all: an ad-hoc capture script run from inside
# web-sdk/apps/Ride-The-Bus/ once put 18 PNGs in that app's own scripts/
# directory, where the anchored pattern did not reach them and `git status`
# offered them up for commit.
scripts/.shots/
.shots/

# Graphify knowledge graph output (regenerable: npm run graph)
graphify-out/
# Shadow-tree intermediates. graph-build.mjs removes these itself; a build
# killed mid-run does not, and a stray shadow tree must never be committed.
.graph-*/
