# Build-time public constants, read by packages/envs via $env/static/public.
#
# These three are imported unconditionally by the vendored SDK, so leaving them
# undeclared made every build print "PUBLIC_x is not exported by
# virtual:env/static/public". The values resolved to `undefined`, which happened
# to behave correctly - but a warning that is always present is a warning nobody
# reads, and this is the file the convention expects them in. Only `.env` and
# the `.local` variants are gitignored; `.env.<mode>` is committed config.
#
# PUBLIC_ is SvelteKit's prefix for "safe to ship to the browser". Nothing
# secret belongs here - put that in .env.local, which stays untracked.

# Shown by the SDK's GameVersion component, which this game does not render.
PUBLIC_SITE_MODE=production

# Sentry is not wired up. Empty rather than absent, so the import resolves.
PUBLIC_SENTRY_DSN=

# Chromatic is a visual-regression harness. When true, utils-book forces
# book playback down its deterministic path - must stay false in a real build.
PUBLIC_CHROMATIC=false
